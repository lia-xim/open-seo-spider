      "path": "crates/core/src/api_enrichment_tests.rs",
      "label": "Retain genuine exact8192 import and plus1 refusal; forge typed legacy-like Core plan without an impossible successful overcap import",
      "offset": 13225,
      "before": "    // A plan produced before the new prepare guard still faces the original run-time authority guard.\n    let mut legacy=exact;legacy.input=import_url_list(over.as_bytes(),&options()).unwrap();legacy.unique_urls=vec![legacy.input.rows[0].normalized_url.clone().unwrap()];",
      "after": "    assert!(import_url_list(over.as_bytes(),&options()).is_err());\n    // Synthetic forged legacy-like typed plan, NOT a successful historical or current overcap import.\n    // The unchanged run-time provenance/URL authority must reject before any provider call.\n    let mut legacy=exact;legacy.input.input_bytes=over.len();legacy.input.input_sha256=api_sha(over.as_bytes());legacy.input.rows[0].raw_value=over.clone();legacy.input.rows[0].normalized_url=Some(format!(\"{}a\",legacy.unique_urls[0]));legacy.unique_urls=vec![legacy.input.rows[0].normalized_url.clone().unwrap()];",
