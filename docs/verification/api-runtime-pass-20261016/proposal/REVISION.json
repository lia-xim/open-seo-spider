      "path": "crates/app/src/enrichment_app_tests.rs",
      "label": "Retain genuine overcap import refusal; construct explicitly forged legacy-like typed App plan from a genuine exact8192 plan",
      "offset": 10683,
      "before": "    let mut legacy=prepare(&request(\"https://example.test/valid\")).unwrap();legacy.input=open_seo_spider_core::import_url_list(raw.as_bytes(),&r.import).unwrap();legacy.unique_urls=vec![legacy.input.rows[0].normalized_url.clone().unwrap()];",
      "after": "    assert!(open_seo_spider_core::import_url_list(raw.as_bytes(),&r.import).is_err());\n    let exact_raw=raw.strip_suffix('a').unwrap();let exact=prepare(&request(exact_raw)).unwrap();assert_eq!(exact.unique_urls[0].len(),8192);\n    // Synthetic forged legacy-like typed plan, NOT a successful import of an8193-byte normalized URL.\n    // The unchanged App service must re-import the original bytes and refuse before store/owner/provider admission.\n    let mut legacy=exact;legacy.input.input_bytes=raw.len();legacy.input.input_sha256=api::api_sha(raw.as_bytes());legacy.input.rows[0].raw_value=raw.clone();legacy.input.rows[0].normalized_url=Some(format!(\"{}a\",legacy.unique_urls[0]));legacy.unique_urls=vec![legacy.input.rows[0].normalized_url.clone().unwrap()];",
