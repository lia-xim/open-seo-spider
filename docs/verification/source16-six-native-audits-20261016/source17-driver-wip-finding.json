  "findings": [
    {
      "id": "S17-WIP-001",
      "priority": 2,
      "path": "E:/CodexWork/open-seo-spider-01a12ac3-20261013/combined-v17-driver-preparation-wip-v1/validate-combined-source-v17.mjs",
      "start_line": 387,
      "end_line": 389,
      "title": "Current Source17 runtime identity is overwritten with a Source16 renderer requirement",
      "body": "physicalRuntime correctly returns PHYSICAL_RUNTIME_IDENTITY_ONLY_FRESH_SOURCE17_RENDERER_TESTS_REQUIRED, but loadApproval and verifyRuntimeIdentity both replace that scope with PHYSICAL_RUNTIME_IDENTITY_ONLY_FRESH_SOURCE16_RENDERER_TESTS_REQUIRED. manifestFrom persists the replacement into the actual combined_source_v17 manifest, and current suite/build/binder propagate it. Change both overrides to SOURCE17 (or preserve the already-correct physicalRuntime scope) before finalizing the operational successors. This is a current-version provenance-label defect; four renderer gates are still explicitly required by the dispatcher.",
      "evidence_occurrences": 2
    }
  ],
  "source_only": true,
  "not_final_runnable_NoF": true,
