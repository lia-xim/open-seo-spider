+fn stop<T>(result: Result<T>, expected: SitemapReadControlError) {
+    let error = match result {
+        Ok(_) => panic!("Expected typed sitemap stop"),
+        Err(error) => error,
+    };
+    assert_eq!(
+        error.downcast_ref::<SitemapReadControlError>(),
+        Some(&expected),
+        "{error:#}"
+    );
+}
