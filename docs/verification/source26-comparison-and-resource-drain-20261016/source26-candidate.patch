+fn reporting_requests() -> [Request; 3] {
+    [
+        Request::default(),
+        request(Channel::Title, ContentCaptureSourceKind::RawHttpHtml),
+        metadata_request(Channel::Title, ContentCaptureSourceKind::RawHttpHtml),
