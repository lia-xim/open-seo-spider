+fn token(scope: &str, id: &str, raw: bool) -> String {
+    let hash = if raw { "b".repeat(64) } else { "a".repeat(64) };
+    if scope == "resource-broken-sources" {
+        format!("resource-sources-v1:{id}:7:{hash}")
