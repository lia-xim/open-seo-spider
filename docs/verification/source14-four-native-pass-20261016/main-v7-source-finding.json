    {
      "id": "MAIN18-CROSS-CHANNEL-CLOSE-ORDER-01",
      "priority": 2,
      "title": "Do not require a total ACK callback order across independent browser channels",
      "file": "E:\\CodexWork\\open-seo-spider-01a12ac3-20261013\\source14-segments-cdn-directory-native-preparation-v7\\browser-owner.mjs",
      "line": 17,
      "trigger": "Chrome completes explicit Browser.close, but the separate Playwright TCP disconnect or OS child close callback reaches this Node event loop before the raw WebSocket ACK callback.",
      "actual": "close() requires ackSequence<disconnectSequence and ackSequence<childCloseSequence. These eventSequence numbers record host callback delivery across different channels, for which the source/producer contract supplies no total order.",
      "impact": "A fully acknowledged, naturally closed browser with all pipe EOF and no retained work can be rejected by a race in the harness. Running V7 would risk another false native failure; it is not source-admissible.",
      "requested_change": "Keep the exact same-raw-WS matching ACK → only permitted TypeError → remote close ordering. Correlate independent Playwright disconnect and child close to previously established explicit closeIntent plus the actual closeCommandID/forced=false event snapshots; require every observed endstate, natural exit/close0, complete pipes/FDs and final pending0 before qualification. Remove only the unproved cross-channel ACK inequalities. Preserve all raw diagnostic rows and failure-only nonqualification.",
      "evidence": {
        "matching_raw_socket_ACK_is_synchronous": true,
        "separate_channels": [
          "Node raw WebSocket",
          "Playwright CDP TCP connection",
          "child_process OS exit/close callbacks"
        ],
        "historical_V6_order_unknown": true
      },
